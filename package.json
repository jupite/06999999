{
  "name": "homura-personal-site",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @site/web dev",
    "build": "pnpm --filter @site/web build",
    "typecheck": "pnpm --filter @site/web typecheck",
    "test": "pnpm --filter @site/web test",
    "db:generate": "pnpm --filter @site/web db:generate",
    "db:validate": "pnpm --filter @site/web db:validate",
    "db:deploy": "pnpm --filter @site/web db:deploy",
    "db:status": "pnpm --filter @site/web db:status",
    "db:migrate": "pnpm --filter @site/web db:migrate",
    "format": "prettier --write \"*.{json,jsonc,yaml,yml,md,js,mjs,cjs}\" \".vscode\" \"apps/web\" \"doc\" \"infra\" --ignore-unknown",
    "format:check": "prettier --check \"*.{json,jsonc,yaml,yml,md,js,mjs,cjs}\" \".vscode\" \"apps/web\" \"doc\" \"infra\" --ignore-unknown",
    "test:drafts": "pnpm --filter @site/web exec tsx --conditions=react-server --test src/server/services/drafts.integration.test.ts",
    "test:articles": "pnpm --filter @site/web exec tsx --conditions=react-server --test src/server/services/drafts.integration.test.ts src/server/services/articles.integration.test.ts",
    "test:media": "pnpm --filter @site/web exec tsx --conditions=react-server --test src/server/services/media.integration.test.ts",
    "test:projects": "pnpm --filter @site/web exec tsx --conditions=react-server --test src/server/services/project-sites.integration.test.ts"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
