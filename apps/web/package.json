{
  "name": "@site/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test src/server/domain/*.test.ts src/i18n/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate dev",
    "format": "pnpm --workspace-root run format",
    "format:check": "pnpm --workspace-root run format:check"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-auth": "4.24.15",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "lucide-react": "^0.468.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.6"
  }
}
