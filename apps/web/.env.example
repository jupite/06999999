# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://site:local-development-only@localhost:5432/site
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub account ID, not login name. No first-user admin promotion.
OWNER_GITHUB_ID=
PYTHON_API_URL=http://localhost:8000
PYTHON_SERVICE_TOKEN=
# Absolute persistent path outside the release directory; configure before uploads.
MEDIA_ROOT=
# Base URL of a trusted, self-hosted NetEase Cloud Music API Enhanced service.
NETEASE_MUSIC_API_URL=

# Local admin is initialized with: node scripts/init-admin.mjs
# Runtime reads ADMIN_USERNAME / ADMIN_PASSWORD_HASH from ignored .env.admin.local.
